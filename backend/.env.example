# ========================================
# IG REAL ESTATE PLATFORM - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values

# ========================================
# REQUIRED VARIABLES
# ========================================

# Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LLM Configuration (At least one required)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# OR
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development

# ========================================
# OPTIONAL VARIABLES
# ========================================

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Celery Result Backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Configuration
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=30

# Instagram API (Optional)
INSTAGRAM_PAGE_ACCESS_TOKEN=EAAG...
INSTAGRAM_VERIFY_TOKEN=your-verify-token
INSTAGRAM_APP_SECRET=your-app-secret
INSTAGRAM_PAGE_ID=123456789

# Google Services (Optional)
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_MAPS_API_KEY=AIzaSy...
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# HubSpot CRM (Optional)
HUBSPOT_API_KEY=pat-na1-your-hubspot-key
HUBSPOT_PORTAL_ID=123456

# Neo4j (Optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Security (Required for Production)
SECRET_KEY=your-production-secret-key-change-this
AUDIT_SALT=your-production-audit-salt-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Settings
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
LOG_LEVEL=INFO

# ========================================
# FEATURE FLAGS
# ========================================

ENABLE_ROUTER_AGENT=true
ENABLE_TEMPORAL_GRAPH=true
ENABLE_COMPLIANCE_CHECKS=true
ENABLE_REAL_INSTAGRAM_API=false
ENABLE_GOOGLE_CALENDAR=false
ENABLE_HUBSPOT_SYNC=false
ENABLE_AUDIT_LOGGING=true
ENABLE_FAIR_HOUSING_LLM=true

# ========================================
# BUSINESS LOGIC
# ========================================

HIGH_VALUE_LEAD_THRESHOLD=500000
QUALIFICATION_SCORE_THRESHOLD=0.7
MAX_PROPERTIES_PER_QUERY=50
CACHE_TTL_SECONDS=3600

# ========================================
# COMPLIANCE
# ========================================

GDPR_RETENTION_DAYS=2555
TCPA_CONSENT_EXPIRY_DAYS=547
FAIR_HOUSING_STRICT_MODE=true

# ========================================
# PERFORMANCE
# ========================================

MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_SECONDS=30
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ========================================
# MONITORING
# ========================================

HEALTH_CHECK_INTERVAL=60
METRICS_RETENTION_DAYS=90

# ========================================
# RATE LIMITING
# ========================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ========================================
# OBSERVABILITY (Optional)
# ========================================

SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com